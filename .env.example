# EduMail Generator - এনভায়রনমেন্ট ভেরিয়েবল টেমপ্লেট
# এই ফাইলটি .env নামে সংরক্ষণ করুন এবং আপনার তথ্য দিয়ে পূরণ করুন

# Django সেটিংস
SECRET_KEY=your_django_secret_key_here_change_this_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL ডাটাবেস সেটিংস
DB_ENGINE=django.db.backends.postgresql
DATABASE_NAME=edumail_generator
DATABASE_USER=edumail_user
DATABASE_PASSWORD=secure_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# SendGrid ইমেইল সেটিংস
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@edumail-generator.com

# ইমেইল ব্যাকএন্ড
EMAIL_BACKEND=sendgrid_backend.SendgridBackend

# অ্যাপ্লিকেশন ইউআরএল
SITE_URL=http://localhost:8000

# নিরাপত্তা (উৎপাদনে পরিবর্তন করুন)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
